ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/verifact.db

# mock = deterministic local responses for development/tests. live = real LLM provider.
# Mock mode is not a production feature; the UI labels it as Demo / Mock Mode.
LLM_MODE=mock
MOCK_SCENARIO=mixed

OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

GENERATOR_MODEL=gpt-4o-mini
VERIFIER_MODEL=gpt-4o-mini
GENERATOR_MODEL_A=gpt-4o-mini
GENERATOR_MODEL_B=gpt-4o
VERIFIER_MODEL_A=gpt-4o-mini
VERIFIER_MODEL_B=gpt-4o
ALLOWED_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1

SYNONYM_COUNT=5
ANTONYM_COUNT=5
THRESHOLD=0.5
VERIFY_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
MAX_QUESTIONS=40
LIVE_UNCONFIRMED_MAX_QUESTIONS=1
