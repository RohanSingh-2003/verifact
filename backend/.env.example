ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/verifact.db

LLM_MODE=live

# Multi-Model Cloud Providers (Strict Cloud-API-Only Architecture)
# 1. Ollama Cloud — Gemma 4:26B
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=

# 2. Cloudflare Workers AI — GLM-4.7-Flash
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash

# 3. Groq — Qwen
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 4. OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free


# 5. Google Gemini — Gemini Flash 3.8
GEMINI_API_KEY=
GEMINI_VERIFIER_MODEL=gemini-3.8-flash
GEMINI_VERIFY_CONCURRENCY=3

# Web Evidence Verification (independent of MetaQA). Uses Tavily Search.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=30
WEB_EVIDENCE_ENABLED=true
WEB_MAX_CLAIMS=3
WEB_MAX_SEARCHES=3
WEB_RESULTS_PER_CLAIM=2
LLM_WEB_CLAIM_MAX_TOKENS=400
LLM_WEB_VERIFY_MAX_TOKENS=160

# MetaQA Pipeline Parameters
SYNONYM_COUNT=3
ANTONYM_COUNT=3
THRESHOLD=0.5
VERIFY_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
LLM_ANSWER_MAX_TOKENS=350
LLM_CLAIM_MAX_TOKENS=256
LLM_MUTATION_MAX_TOKENS=300
LLM_VERIFY_MAX_TOKENS=256

MAX_QUESTIONS=40
LIVE_UNCONFIRMED_MAX_QUESTIONS=1
