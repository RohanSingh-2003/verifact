ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/verifact.db

# LLM Provider: ollama (default) | openai_compatible
LLM_PROVIDER=ollama

# Local Ollama endpoint. Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_ALLOWED_MODELS=gemma4:26b

# OpenAI-compatible fallback (when LLM_PROVIDER=openai_compatible)
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

GENERATOR_MODEL=gemma4:26b
VERIFIER_MODEL=gemma4:26b
GENERATOR_MODEL_A=gemma4:26b
GENERATOR_MODEL_B=gemma4:26b
VERIFIER_MODEL_A=gemma4:26b
VERIFIER_MODEL_B=gemma4:26b
ALLOWED_MODELS=gemma4:26b,gpt-4o-mini,gpt-4o

# Optional separate model for mutation generation (leave empty to use GENERATOR_MODEL):
# MUTATION_MODEL=gemma4:26b

# Interactive Detect speed knobs (2×2 experiments still commonly use synonym/antonym=5):
# After the AI answer is ready, MetaQA and Web Evidence run as independent parallel pipelines.
SYNONYM_COUNT=3
ANTONYM_COUNT=3
THRESHOLD=0.5
VERIFY_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
LLM_ANSWER_MAX_TOKENS=350
LLM_CLAIM_MAX_TOKENS=256
LLM_MUTATION_MAX_TOKENS=300
LLM_VERIFY_MAX_TOKENS=256
OLLAMA_KEEP_ALIVE=30m

# Gemini Verifier — cross-model MetaQA mutation verification.
# Ollama/Gemma generates the answer and mutations; Gemini ONLY verifies mutations.
# This enables comparison between same-model and cross-model verifier behavior.
# Leave GEMINI_API_KEY empty to disable Gemini verification (MetaQA will report unavailable).
GEMINI_API_KEY=
GEMINI_VERIFIER_MODEL=gemini-3.8-flash
GEMINI_VERIFY_CONCURRENCY=3

# Web Evidence Verification (independent of MetaQA). Uses Tavily Basic Search.
# Leave TAVILY_API_KEY empty to disable web search (status: unavailable).
# Conservative development caps: claim searches run concurrently within WEB_MAX_SEARCHES.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=30
WEB_EVIDENCE_ENABLED=true
WEB_MAX_CLAIMS=3
WEB_MAX_SEARCHES=3
WEB_RESULTS_PER_CLAIM=2
LLM_WEB_CLAIM_MAX_TOKENS=400
LLM_WEB_VERIFY_MAX_TOKENS=160

MAX_QUESTIONS=40
LIVE_UNCONFIRMED_MAX_QUESTIONS=1
