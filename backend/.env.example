ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/verifact.db

# mock = deterministic local responses for development/tests. live = real LLM provider.
# Mock mode is not a production feature; the UI labels it as Demo / Mock Mode.
LLM_MODE=mock
MOCK_SCENARIO=mixed

# openai_compatible | ollama
LLM_PROVIDER=openai_compatible

OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama (OpenAI-compatible). Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_ALLOWED_MODELS=gemma4:26b

GENERATOR_MODEL=gpt-4o-mini
VERIFIER_MODEL=gpt-4o-mini
GENERATOR_MODEL_A=gpt-4o-mini
GENERATOR_MODEL_B=gpt-4o
VERIFIER_MODEL_A=gpt-4o-mini
VERIFIER_MODEL_B=gpt-4o
ALLOWED_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1

# Example Ollama live configuration (copy into .env when using local Gemma):
# LLM_MODE=live
# LLM_PROVIDER=ollama
# GENERATOR_MODEL=gemma4:26b
# VERIFIER_MODEL=gemma4:26b
# GENERATOR_MODEL_A=gemma4:26b
# GENERATOR_MODEL_B=gemma4:26b
# VERIFIER_MODEL_A=gemma4:26b
# VERIFIER_MODEL_B=gemma4:26b
# Interactive Detect speed knobs (2×2 experiments still default to synonym/antonym=5):
# SYNONYM_COUNT=3
# ANTONYM_COUNT=3
# VERIFY_CONCURRENCY=3
# LLM_TIMEOUT_SECONDS=300
# LLM_ANSWER_MAX_TOKENS=350
# LLM_CLAIM_MAX_TOKENS=256
# LLM_MUTATION_MAX_TOKENS=700
# LLM_VERIFY_MAX_TOKENS=96
# OLLAMA_KEEP_ALIVE=30m
# Note: LLM_PROVIDER=ollama uses the native Ollama /api/chat client (think disabled).

SYNONYM_COUNT=5
ANTONYM_COUNT=5
THRESHOLD=0.5
VERIFY_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
LLM_ANSWER_MAX_TOKENS=350
LLM_CLAIM_MAX_TOKENS=256
LLM_MUTATION_MAX_TOKENS=700
LLM_VERIFY_MAX_TOKENS=96
OLLAMA_KEEP_ALIVE=30m
MAX_QUESTIONS=40
LIVE_UNCONFIRMED_MAX_QUESTIONS=1
