# VeriFact Environment Configuration Example
# See backend/.env.example for the full set of backend options.

LLM_MODE=live
LLM_PROVIDER=ollama
GENERATOR_MODEL=gemma4:26b
VERIFIER_MODEL=gemma4:26b

# Gemini Verifier — cross-model MetaQA mutation verification
# Gemini is used ONLY for verifying mutations. Ollama remains the generator.
GEMINI_API_KEY=
GEMINI_VERIFIER_MODEL=gemini-2.5-flash
GEMINI_VERIFY_CONCURRENCY=3

# Web Evidence (independent of MetaQA)
TAVILY_API_KEY=
