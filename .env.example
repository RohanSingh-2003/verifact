# VeriFact Environment Configuration Example
# See backend/.env.example for the full set of backend options.

LLM_MODE=live

# Multi-Model Cloud Providers (Phase 1)
# All models run through cloud APIs with zero local inference.

# 1. Ollama Cloud (Gemma 4:26B)
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api

# 2. Cloudflare Workers AI (GLM-4.7-Flash)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash

# 3. Groq API (Qwen)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 4. OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# 5. Google Gemini API (Gemini Flash 3.8)
GEMINI_API_KEY=

# Web Evidence (independent of MetaQA)
TAVILY_API_KEY=
